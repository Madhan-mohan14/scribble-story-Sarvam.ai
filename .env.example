# ---------------------------------------------------------------------------
# Sarvam AI — speech (Bulbul v3) and translation
# ---------------------------------------------------------------------------
# Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# Optional: several keys, comma-separated. Trial keys run out of credits
# quickly, so the app automatically moves to the next one when a key fails
# — no restart or redeploy needed mid-demo.
# SARVAM_API_KEY=first-key,second-key,third-key


# ---------------------------------------------------------------------------
# Google Gemini 2.5 Flash — reads the drawing and writes the story
# Pick ONE of the two options below.
# ---------------------------------------------------------------------------

# Option A (easiest — recommended if you just cloned this):
# A Gemini API key from https://aistudio.google.com/apikey
# No GCP project, no billing setup, no gcloud install.
GOOGLE_API_KEY=your-gemini-api-key

# Option B: Vertex AI instead. Used automatically when GOOGLE_API_KEY is
# empty. Needs a GCP project with the Vertex AI API enabled, plus
# `gcloud auth application-default login` so credentials are available.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
